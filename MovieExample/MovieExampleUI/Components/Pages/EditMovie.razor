@page "/EditMovie/{Name}"
@using Services
@using Services.DTOs

@inject MovieService MovieServiceInjected

<h3 class="mb-4">Edit Movie</h3>

@if (Dto != null)
{
    <EditForm Model="@Dto" OnValidSubmit="OnSubmit">
        <div class="mb-3">
            <label for="name" class="form-label">Name</label>
            <input type="text" class="form-control" @bind-value="Dto.Name" placeholder="Name" id="name">
        </div>
        <div class="mb-3">
            <label for="releaseDate" class="form-label">Release Date</label>
            <input type="date" class="form-control" @bind-value="Dto.ReleaseDate" id="releaseDate">
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
    </EditForm>
}
else
{
    <div class="alert alert-warning">Movie Not Found</div>
}

@code {

    public EditMovieDto? Dto { get; set; }

    [Parameter] public string Name { get; set; }

    protected override void OnInitialized()
    {
        Dto = MovieServiceInjected.GetMovieByName(Name);
    }

    public void OnSubmit()
    {
        MovieServiceInjected.UpdateMovie(Dto);
    }

}