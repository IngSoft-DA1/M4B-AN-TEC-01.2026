@page "/"
@page "/AddMovie"

@using Domain
@using Services

@inject MovieService MovieServiceInjected


<h3>Add Movie</h3>

<EditForm Model="@movie" OnSubmit="OnSave">
    <input type="text" @bind-value="@movie.Name" id="name">
    <button type="submit"> Save </button>
</EditForm>


@code {
    public Movie movie = new Movie();
    

    public void OnSave()
    {
        MovieServiceInjected.AddMovie(movie);
    }

}