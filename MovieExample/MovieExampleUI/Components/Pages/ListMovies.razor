@page "/ListMovies"
@using Domain
@using Services

@inject MovieService MovieServiceInjected
@inject NavigationManager NavigationManagerInjected

<h3>List Movies</h3>


<table style="width: 100%; border-collapse: collapse; font-family: Arial, sans-serif;">
    <thead>
    <tr style="background-color: #2c3e50; color: white;">
        <th style="padding: 12px 16px; text-align: left;">Name</th>
        <th style="padding: 12px 16px; text-align: left;">Action</th>
    </tr>
    </thead>
    <tbody>
    @foreach (Movie movie in Movies)
    {
        <tr style="border-bottom: 1px solid #ddd;">
            <td style="padding: 10px 16px;">@movie.Name</td>
            <td style="padding: 10px 16px;">
                <button type="button"
                        @onclick="() => GoToEdit(movie.Name)"
                        style="background-color: #3498db; color: white; border: none; padding: 6px 14px; border-radius: 4px; cursor: pointer;">
                    Edit
                </button>
            </td>
        </tr>
    }
    </tbody>
</table>

@code {
    public List<Movie> Movies { get; set; }

    protected override void OnInitialized()
    {
        Movies = MovieServiceInjected.ListAllMovies();
    }

    public void GoToEdit(string name)
    {
        NavigationManagerInjected.NavigateTo($"/EditMovie/{name}");
    }


}