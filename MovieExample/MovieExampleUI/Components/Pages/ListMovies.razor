@page "/ListMovies"
@using Domain
@using Services

@inject MovieService MovieServiceInjected
@inject NavigationManager NavigationManagerInjected

<h3 class="mb-4">List Movies</h3>

<table class="table table-striped table-hover">
    <thead class="table-dark">
    <tr>
        <th>Name</th>
        <th>Release Date</th>
        <th>Action</th>
    </tr>
    </thead>
    <tbody>
    @foreach (Movie movie in Movies)
    {
        <tr>
            <td>@movie.Name</td>
            <td>@movie.ReleaseDate.ToShortDateString()</td>
            <td>
                <button type="button" class="btn btn-primary btn-sm" @onclick="() => GoToEdit(movie.Name)">
                    Edit
                </button>
            </td>
        </tr>
    }
    </tbody>
</table>

@code {
    public List<Movie> Movies { get; set; }

    protected override void OnInitialized()
    {
        Movies = MovieServiceInjected.ListAllMovies();
    }

    public void GoToEdit(string name)
    {
        NavigationManagerInjected.NavigateTo($"/EditMovie/{name}");
    }


}